{
  "name": "qysuperbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build:binance-client": "node scripts/build-binance-client.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs watch --tsconfig apps/server/tsconfig.json apps/server/src/main.ts",
    "dev:admin": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --config apps/admin/vite.config.ts",
    "build": "npm run build:binance-client && tsc -p apps/server/tsconfig.build.json && vite build --config apps/admin/vite.config.ts && node scripts/package-binance-extension.mjs",
    "package:binance-extension": "npm run build:binance-client && node scripts/package-binance-extension.mjs",
    "start": "node --env-file-if-exists=.env dist/server/apps/server/src/main.js",
    "demo": "node examples/custom-chat/demo.ts",
    "test": "tsx --tsconfig apps/server/tsconfig.json --test packages/contracts/test/*.test.ts apps/server/test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p apps/server/tsconfig.json && tsc -p apps/admin/tsconfig.json",
    "check": "npm run typecheck && npm test",
    "dev:demo": "vite --config apps/admin/vite.config.ts --mode demo",
    "build:demo": "tsc -p apps/admin/tsconfig.json && vite build --config apps/admin/vite.config.ts --mode demo",
    "preview:demo": "vite preview --config apps/admin/vite.config.ts --mode demo --host 127.0.0.1 --port 5188",
    "test:demo": "node --experimental-strip-types --test apps/admin/test/demo.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "express": "^5.3.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.61.0",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^7.30.1",
    "ws": "^8.22.0",
    "zod": "^4.0.0"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
