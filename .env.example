# Local: npm run dev (persistent PGlite). Production: set DATABASE_URL to PostgreSQL.
HOST=127.0.0.1
PORT=3000
ADMIN_PORT=5174
PUBLIC_ORIGIN=http://localhost:3000
DATA_DIR=.local/data
SEED_DEMO=true
# DATABASE_URL=postgresql://superbot:change-me@localhost:5432/superbot
# ADMIN_SETUP_TOKEN=choose-a-long-random-setup-token-before-binding-a-public-interface
# COOKIE_SECURE=true
# ENCRYPTION_KEY=64-hex-characters-or-leave-empty-for-a-persistent-local-key-file
# Allow trusted, administrator-configured local QQ/custom connector endpoints.
ALLOW_PRIVATE_CONNECTORS=false
# Optional: allow only QQ HTTP calls to http://127.0.0.1:<port> on this server.
# QQ_LOCAL_PORT=3004
# Optional: same-server NapCat QR login, accessible only through the admin console.
# QQ_WEBUI_PORT=6099
# QQ_WEBUI_TOKEN=the-private-token-from-the-server-napcat-webui-config
# Optional Linux server browser: install Google Chrome, Xvfb and xauth first.
# BINANCE_BROWSER_ENABLED=true
# BINANCE_BROWSER_EXECUTABLE=/usr/bin/google-chrome
