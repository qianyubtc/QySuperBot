[Unit]
Description=Qianyu Superbot QQ bridge (NapCat)
After=network-online.target qianyusuperbot.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=qsb-qq
Group=qsb-qq
WorkingDirectory=/var/lib/qianyusuperbot-qq
ExecStart=/usr/bin/xvfb-run -a /opt/qianyusuperbot-qq/current/opt/QQ/qq --no-sandbox
Restart=on-failure
RestartSec=10
TimeoutStopSec=25
LimitCORE=0
UMask=0077
StateDirectory=qianyusuperbot-qq
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/qianyusuperbot-qq
MemoryMax=1G

[Install]
WantedBy=multi-user.target
